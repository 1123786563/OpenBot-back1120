      "checkConstraints": {
        "billing_credit_lot_source_check": {
          "name": "billing_credit_lot_source_check",
          "value": "\"billing\".\"credit_lot\".\"source_type\" IN ('subscription', 'pack', 'compensation')"
        },
        "billing_credit_lot_status_check": {
          "name": "billing_credit_lot_status_check",
          "value": "\"billing\".\"credit_lot\".\"status\" IN ('scheduled', 'active', 'frozen', 'exhausted', 'expired', 'revoked')"
        },
        "billing_credit_lot_nonnegative_check": {
          "name": "billing_credit_lot_nonnegative_check",
          "value": "\"billing\".\"credit_lot\".\"available_microcredits\" >= 0 AND \"billing\".\"credit_lot\".\"reserved_microcredits\" >= 0 AND \"billing\".\"credit_lot\".\"refund_frozen_microcredits\" >= 0\n          AND \"billing\".\"credit_lot\".\"consumed_microcredits\" >= 0 AND \"billing\".\"credit_lot\".\"expired_microcredits\" >= 0 AND \"billing\".\"credit_lot\".\"revoked_microcredits\" >= 0\n          AND \"billing\".\"credit_lot\".\"granted_microcredits\" >= 0"
        },
        "billing_credit_lot_conservation_check": {
          "name": "billing_credit_lot_conservation_check",
          "value": "\"billing\".\"credit_lot\".\"granted_microcredits\" = \"billing\".\"credit_lot\".\"available_microcredits\" + \"billing\".\"credit_lot\".\"reserved_microcredits\" + \"billing\".\"credit_lot\".\"refund_frozen_microcredits\"\n          + \"billing\".\"credit_lot\".\"consumed_microcredits\" + \"billing\".\"credit_lot\".\"expired_microcredits\" + \"billing\".\"credit_lot\".\"revoked_microcredits\""
        },
        "billing_credit_lot_pack_lifetime_check": {
          "name": "billing_credit_lot_pack_lifetime_check",
          "value": "\"billing\".\"credit_lot\".\"source_type\" <> 'pack' OR (\"billing\".\"credit_lot\".\"source_period_id\" IS NULL AND \"billing\".\"credit_lot\".\"expires_at_us\" IS NULL)"
        },
        "billing_credit_lot_subscription_period_check": {
          "name": "billing_credit_lot_subscription_period_check",
          "value": "\"billing\".\"credit_lot\".\"source_type\" <> 'subscription' OR (\"billing\".\"credit_lot\".\"source_period_id\" IS NOT NULL AND \"billing\".\"credit_lot\".\"expires_at_us\" IS NOT NULL AND \"billing\".\"credit_lot\".\"expires_at_us\" > \"billing\".\"credit_lot\".\"valid_from_us\")"
        },
        "billing_credit_lot_compensation_expiry_check": {
          "name": "billing_credit_lot_compensation_expiry_check",
          "value": "\"billing\".\"credit_lot\".\"source_type\" <> 'compensation' OR (\"billing\".\"credit_lot\".\"expires_at_us\" IS NOT NULL AND \"billing\".\"credit_lot\".\"expires_at_us\" > \"billing\".\"credit_lot\".\"valid_from_us\")"
        },
        "billing_credit_lot_compensation_origin_check": {
