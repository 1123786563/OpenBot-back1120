# T01 environment template — copy to scripts/t01/.env.t01 and fill in.
# .env.t01 holds runtime secrets and is NEVER committed. This file must stay
# free of real secret values (AC-10); 80-secret-scan.sh checks the tree.
#
# Nothing below is a usable credential; every VALUE line you copy from here
# that says <generate> must come from `openssl rand -base64 32` at runtime.

# --- images (filled by scripts/t01/00-pin-images.sh; do not hand-edit) ---
# T01_SERVER_IMAGE=ghcr.io/copilotkit/openbot@sha256:<64 hex>
# T01_CASDOOR_IMAGE=casbin/casdoor-all-in-one@sha256:<64 hex>
# T01_PGVECTOR_IMAGE=pgvector/pgvector@sha256:<64 hex>

# --- OpenBot server (requirements from docs/configuration.md) ---
OPENBOT_EDITION=team
# Inside compose the server reaches postgres by service name; this value is
# overridden by compose.t01.yml but kept here so a host-run server also works:
DATABASE_URL=postgres://openbot:openbot-t01@127.0.0.1:5432/openbot
KEY_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
# Callbacks and the app come back to this origin; the server serves the app.
BETTER_AUTH_URL=http://127.0.0.1:13010
# First-admin bootstrap: these addresses become administrators at every
# sign-in. Test identities only, never a real account.
INITIAL_ADMIN_EMAILS=admin@t01.test
# Exact-match domain gate for who may sign in (no wildcards).
SIGNIN_ALLOWED_EMAIL_DOMAINS=t01.test
# The API accepts these app origins, and every OIDC provider registration must
# have ALL discovery-document endpoint hosts listed here — that means Casdoor's
# issuer AND its token/jwks/userinfo hosts, all served from 127.0.0.1:18000.
TRUSTED_ORIGINS=http://127.0.0.1:13010,http://127.0.0.1:18000

# --- server startup gates outside this ticket's scope ---
# The server refuses to start without Intelligence settings and a CopilotKit
# license or Intelligence project key (docs/configuration.md). Fill from your
# own entitlements; never commit real values:
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=
# INTELLIGENCE_API_KEY=
# COPILOTKIT_LICENSE_TOKEN=

# --- Casdoor bootstrap (used by 20-casdoor-app.sh, runtime only) ---
# Admin of the FRESH Casdoor instance created by initDataNewOnly. Look up the
# built-in admin credentials in the Casdoor all-in-one image docs on first run
# and change them before storing anything here.
# T01_CASDOOR_ADMIN_USER=admin
# T01_CASDOOR_ADMIN_PASSWORD=
# OIDC client secret Casdoor issues for the T01 application; lives only in the
# server's encrypted identity-provider registration, never in git (AC-10).
# T01_CASDOOR_CLIENT_ID=
# T01_CASDOOR_CLIENT_SECRET=

# --- test identities (passwords runtime-only) ---
# T01_ADMIN_PASSWORD=
# T01_USER_PASSWORD=
# T01_USER2_PASSWORD=
