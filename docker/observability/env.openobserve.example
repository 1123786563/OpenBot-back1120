# Copy to env.openobserve, restrict permissions to the operator, and set a strong password.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=
ZO_COMPACT_DATA_RETENTION_DAYS=30
OO_ENVIRONMENT_LABEL=production

# Base64 of default:<OpenObserve organization ingestion token>. See the runbook.
OO_INGEST_BASIC=

# Collector audit traffic belongs on OpenBot's trusted data network.
# OO_NETWORK=openbot_data
# OO_QUERY_PORT=5080
# OO_FORWARD_PORT=24224

# ARM64 Docker hosts use these pinned builds.
# OO_PLATFORM=linux/arm64
# OO_IMAGE=openobserve/openobserve:v1.1.2-arm64@sha256:e4cb7e211399183357dbd831cb92311181a3d24255aff711c1027e129652c209
# OO_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.165.0-arm64@sha256:19b524dc61144cb50e9dccc9469605706db48e3302ddccda404a0aaf0a99a73f
