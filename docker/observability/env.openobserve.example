# Copy to `env.openobserve` (git-ignored) and fill in before starting
# `docker/observability/compose.yml`. This file holds the OpenObserve root credentials and the
# collector's ingest credential — the only places they exist, and neither ever reaches a business
# process (the server exports audit OTLP to the collector unauthenticated inside the Docker
# network).

# The one administrator account OpenObserve initializes on first start. The platform
# administrator keeps these; nobody else is given OpenObserve credentials at all.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=

# Global data retention floor in days.
ZO_COMPACT_DATA_RETENTION_DAYS=30

# What the collector stamps on every record as `deployment_environment`. Use the deployment's
# own name (`dev`, `staging`, `production`); never infer it from log content.
OO_ENVIRONMENT_LABEL=dev

# The collector's `Authorization: Basic` value for OpenObserve's ingest API, base64 of
# `ZO_ROOT_USER_EMAIL:ZO_ROOT_USER_PASSWORD`. Mint it once:
#
#   printf '%s:%s' "$ZO_ROOT_USER_EMAIL" "$ZO_ROOT_USER_PASSWORD" | base64
#
OO_INGEST_BASIC=

# The OpenBot Compose network to attach to, when the deployment's project is not `openbot`.
# OO_NETWORK=openbot_default
