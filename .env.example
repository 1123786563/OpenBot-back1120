DATABASE_URL=postgres://openbot:openbot@localhost:5432/openbot
# 凭据库加密密钥。示例值是公开的,仅适用于本地开发。
# 生产环境使用此密钥会拒绝启动。
#   openssl rand -base64 32
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 保留多少天的审计记录。未设置则保留全部,这是安全默认值,
# 在有人明确决定之前应保持原样:审计记录只增不改,没有其他
# 办法可以删除一行,所以这是它唯一的收缩方式。
# AUDIT_RETENTION_DAYS=365
# 一个数字的两个名字,两者都设置时必须一致。
#
# 服务器接受 PORT 或 SERVER_PORT(server/src/config.ts)任一个,两者同时
# 存在时优先使用 PORT,不一致则拒绝启动,所以改一处即可。空值视为
# 未设置,因此 SERVER_PORT 已设置时 `PORT=` 也会移动服务器。scripts/start.sh
# 和应用的 Vite 代理读取 SERVER_PORT/APP_PORT,docs/configuration.md 将
# SERVER_PORT 记录为该设置。历史上只发布过 PORT,所以只改一行来移动
# 服务器时,脚本仍盯着 3001:它会读取环境中存在的其他
# 端口,把最先返回的 200 当作成功证明,然后在后续阶段解析那个陌生
# 端口的 HTML 为 JSON 时失败。将两者设为同一个值始终有效。
PORT=3001
SERVER_PORT=3001
TENANT_PACKAGE_DIR=../examples/fintech
# 让 Bot 用它自己写的界面回答:标记、样式和一段它当场生成的
# 脚本,流式写入对话记录,并在一个对本应用没有同源访问权限的
# 沙箱 iframe 中渲染。默认开启;设为 `false` 或 `0` 关闭。
#
# 这不是组件目录。组件是本部署持有的东西,由
# 管理员按 Bot 授予;这里没有任何可授予的东西,因为界面是 Bot 当场
# 写的,对话结束就没了了这是一个部署开关而非按 Bot 授予,
# 因为 SDK 没有提供这样的接缝——见 server/src/config.ts 中的
# DeploymentConfig.generativeUi。
#
# 界面能触达什么由沙箱交给它什么决定,本部署什么也不给它:没有
# 会话、没有同源访问、没有进入你数据的路由。它可以从 CDN 加载
# 库,所以一个浏览器标签不允许访问公网的部署应将此项设为 false。
# OPENBOT_GENERATIVE_UI=false
# 已登录的应用会显示一条提议 CopilotKit 帮助自托管 OpenBot 的横幅,
# 直到每个人关闭它。付费 Intelligence 计划上的部署永远不会显示它。
# 为自己组织运行 OpenBot 的分支(fork)可以为所有人关闭它。
# OPENBOT_SELF_HOST_BANNER=false
# 当多个部署共享同一个 Intelligence 项目时,本部署的自称名称。为
# 开发创建的部署副本使用同一个项目密钥,线程按 Bot 列出,但
# 无法区分对话来自哪个部署。该名称进入本部署铸造的每个线程 id
# 中,使其自己的对话保持可识别。未设置时使用租户包的 id,
# 它能区分两个包,但不能区分同一个包的两个副本
# DEPLOYMENT_ID=
# 登录。下面这一行让部署以唯一的管理员身份运行,完全无需登录,
# 这是在注册 OAuth 客户端之前体验产品的途径。删除它并配置
# 一个 provider,其他人才能访问:该项设置时,每个访客都是管理员
# 没有 provider 且此行删除后,部署会拒绝启动,而不是去猜
OPENBOT_SINGLE_USER=true
# 可选的桌面版员工登录授权:配置了下方 provider 的 OpenBot 部署。
# 与 Intelligence URL/项目凭据分开;密钥保留在授权方。
# 设置后,已验证的员工身份会取代独立身份,即使 SINGLE_USER 为 true。
# OPENBOT_ORGANIZATION_AUTH_URL=https://openbot.company.example
#
# 配置以下三个 provider中的任意一个即可开启登录。配置多个时
# 登录界面会提供多个选项,这是公司迁移期间的正常形态
#
# 无论选择哪个 provider,以下四项都是必需的:
#   BETTER_AUTH_URL 是 OAuth 回调返回的地址,即 3001 端口上的 API
#   BETTER_AUTH_SECRET 为会话 cookie 签名,至少 32 个字符:openssl rand -base64 32
#   TRUSTED_ORIGINS 是应用的来源地址,本地是 3010 端口
#   INITIAL_ADMIN_EMAILS 指定谁是管理员。必填,因为没有其他途径
#   授予该角色,也没有页面可以在之后提升某人。每次登录都会重新
#   读取,所以编辑它是生效的
# BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_SECRET=
# INITIAL_ADMIN_EMAILS=admin@example.com
#
# Google。回调 URI:http://localhost:3001/api/auth/callback/google
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Microsoft(Entra ID)。回调 URI:http://localhost:3001/api/auth/callback/microsoft
# MICROSOFT_OAUTH_TENANT_ID 默认为 `common`,同时接受个人 Microsoft
# 账户和工作账户。只针对自己的公司时,把目录 GUID 放在这里
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common
# OpenBot 自己在 Entra 中的 API,供公司系统以已登录
# 身份调用(docs/configuration.md)。默认为 api://<client id>/.default
# MICROSOFT_OAUTH_API_SCOPE=
# 允许用人员的 Entra 令牌调用 OpenBot 的应用,按客户端 id,逗号分隔
# 未设置则任何应用都不可以。
# MICROSOFT_OAUTH_ALLOWED_CLIENTS=
#
# Okta。回调 URI:http://localhost:3001/api/auth/callback/okta
# issuer 决定了这是你们的自己的 Okta 而非一般意义上的 Okta
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_ISSUER=https://example.okta.com/oauth2/default

# 登录时准入的邮箱域名,逗号分隔。为空则允许所有人,这
# 本就是上面各 provider 已能做到的:Entra 租户默认是 `common`
# (除非修改),即任何 Microsoft 账户(包括个人账户);Okta 没有等价物。Google 有
# `hd` 更强,因为 Google 会验证 Workspace 域名所有权;应在
# 那里同样收窄,而不是只用这个代替
#
# 这是过滤器,不是边界:针对 provider 返回的地址做检查,OpenBot
# 并不要求该地址经过验证。服务器拒绝此项与 MICROSOFT_OAUTH_TENANT_ID=common
# 组合使用,因为那种情况下该地址由登录的租户写入入
#
# 精确确匹配,无通配符,需列出每个用到的域名。`example.com` 既不
# 接受 `sub.example.com` 也不接受 `evil-example.com`。
# SIGNIN_ALLOWED_EMAIL_DOMAINS=example.com,example.co.uk

# 本部署从外部访问的地址。只有当人们要把
# 诸如 Google Drive 之类的连接器,以及关联 GitHub 账户时才需要:它
# 用来构建 vendor 把人送回的回调 URI,必须与管理员注册的
# 逐字符一致。默认为 BETTER_AUTH_URL,所以大多数部署从不设置
# 它;在 API 位于与登录所用不同的公共地址时才设置。两者都
# 没有时,Plugins 页面会说明情况,没有人能连接
# 账户,且 GITHUB_APP_CLIENT_ID 会让服务器在启动时停止
# OPENBOT_PUBLIC_URL=https://openbot.example.com

# 浏览器应用的来源地址。OAuth 回调落在 API 上,需要把人
# 送回某个页面,本地是两个不同端口:应用是 3010,API
# 是 3001。默认为第一个 TRUSTED_ORIGINS 条目,其次为
# OPENBOT_PUBLIC_URL,这对从同一 origin同时提供两者的部署是正确的
# OPENBOT_APP_URL=http://localhost:3010
TRUSTED_ORIGINS=http://localhost:3010

# CopilotKit Intelligence。必填:没有 URL、下方的 gateway URL
# 和密钥,服务器拒绝启动,因为 Intelligence 拥有持久线程和记忆,没有它的部署
# 会忘记每段对话。没有降级模式。
#
# 这两项指向托管服务;除非你自己运行 Intelligence,否则不要动。要
# 在一台 Mac 上试用,CLI 的本地评估会为你写入这两项(见 README.md 中的
# "Intelligence on your own machine"):https://docs.copilotkit.ai/intelligence/self-hosting-local
# 在自己的基础设施上运行生产环境是 Enterprise Intelligence Platform
# 功能,通过 Helm chart 部署:https://docs.showcase.copilotkit.ai/premium/self-hosting
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
#
# 从 CopilotKit CLI 获取密钥:
#
#   npx --yes copilotkit@latest login           # 浏览器登录
#   npx --yes copilotkit@latest project select  # 将 cpk-... 密钥写入 .env 的 CPK_INTELLIGENCE_API_KEY
#   bun scripts/setup-learning.ts             # 确保 Learning 容器存在
#
# OpenBot 直接读取 CPK_INTELLIGENCE_API_KEY。INTELLIGENCE_API_KEY 是旧的后备。
# 两者都设置时,非空的 CPK_INTELLIGENCE_API_KEY 优先
#
# 运行时密钥也在 https://intelligence.copilotkit.ai 你项目的 "API Keys" 下
CPK_INTELLIGENCE_API_KEY=

# 可选,故意留空。托管 Intelligence 从上面的项目密钥
# 推导授权,不签发许可令牌(licence token)。有自己许可证的自托管
# Intelligence 设置此项并转发给运行时;启动不要求它。
COPILOTKIT_LICENSE_TOKEN=

# Learning 默认开启。全新托管设置:login、project select,然后 bun scripts/setup-learning.ts
# 助手创建/复用 openbot 并写入验证过的密钥和容器;自定义目标保留。
# 全新自托管设置:设置它的 API URL,安装 Chrome/Edge,然后运行同一助手登录。
# Admin 中没有保存任何东西且下方无容器时,一旦密钥
# 所属项目的 openbot 容器存在,服务器就会自行分配它。密钥无法创建它:运行
# 助手(它会保留已有密钥)或在 Intelligence 中创建。scripts/start.sh 每次启动
# 都非交互地运行该检查。Admin → Automatic Learning 可启用/禁用,按 Bot 覆盖,并将设置保存在数据库中
# 保存的设置优先,包括关闭。没有分配的容器时收集和
# 投递保持不活跃;OpenBot 仍会启动和聊天
# false 或 0 阻止自动分配 openbot 容器。下方指定容器名也会阻止它。
# OPENBOT_LEARNING_AUTO_ASSIGN=false
# 运行时密钥无法创建 openbot 容器;bun run start 用你的
# CopilotKit CLI 登录来做。在 CopilotKit 本地评估安装上,服务令牌
# 可以连同其项目一起:
# INTELLIGENCE_SERVICE_TOKEN=
# INTELLIGENCE_PROJECT_ID=
# 记忆源按人和与之交谈的 Bot 逐个开启,一旦人关闭
# 某个源就再也开不回来。false 或 0 停止整个部署的新默认值
# OPENBOT_MEMORY_SOURCE_DEFAULTS=false
# 签到(check-in)由 Bot 在对话中提供,它监视的每个东西一个
# 且只在人接受后运行一次。true 恢复旧的默认行为:对 Bot
# 能读取的每样东西每小时签到一次,在人第一次单独与它
# 交谈时开启
# OPENBOT_PROACTIVE_DEFAULTS=true
# 项目凭据保留在服务端;在 Intelligence UI 中查看和发布技能
# CPK_INTELLIGENCE_LEARNING_CONTAINER_ID=support-learning
# 可选的不透明已发布修订 ID;省略则跟随最新
# CPK_INTELLIGENCE_SKILLS_REVISION=exact-revision-id
# 托管/自托管设置与权限见 docs/automatic-learning.md

# OpenBot 只接受来自其自身扩展 id 的 OpenBot Recorder 扩展。分支
# (fork), 或用另一把密钥签名的构建,有另一个 id:在这里列出,逗号
# 分隔,每 32 个字符,从 a 到
# p。任何其他值都会让服务器在启动时停止
# OPENBOT_RECORDER_EXTRA_EXTENSION_IDS=

# Bot 的流在本次部署放弃该轮对话之前可以静默多久,
# 毫秒。Bot 是任何 AG-UI 端点,这意味着它会在回答中途被重新部署,它
# 自己的上游会超时,而且它有时会接受连接后什么都不写
#
# 没有它,通道会一直忙,composer 保持锁,唯一的出路
# 是重新加载
#
# 是静默,不是时长。一轮对话可以在事件持续到达时合法运行
# 一小时;这里衡量的是事件之间的间隔。Bot 被允许
# 工作多久没有任何改变
#
# 一分钟,因为这个期限是一场它必须赢的比赛。本仓库中的每个 Bot 都
# 跑在 Bun 上并设置 `idleTimeout: 120`,(Bun 会在
# 大约超过一秒后拆除卡住的流式响应。设为同样两分钟的
# 的 watchdog 会在 socket 死亡后一秒内到达,谁
# 先到谁决定这个人看到什么:本次部署的判决——点名
# Bot 并说该轮已结束——或"套接字连接意外关闭
# 了且完全没有审计行。Bot 自己空闲超时的一半足够
# 远,答案总是前者
#
# 一分钟仍远长于运行内的任何真实静默。最长合法的是
# 等待模型的第一个 token,那是几秒的事。浏览器工具调用不需要放行:
# 它们在轮次之间运行,而不是在一轮内,因为运行在浏览器执行工具前结束
# 第二轮运行把结果带回来
#
# 0 或不设置此项会关闭 watchdog。什么都不监视,也不会结束任何一轮对话
AGENT_STALL_TIMEOUT_MS=60000

# 模型密钥。概念验证 Bot 需要它,它直接使用 OpenAI 的 API,
# 框架 Bot也需要,除非你在下方把它指向另一个 provider
OPENAI_API_KEY=

# 该密钥的花费之处。未设置时是 OpenAI。设置后,它是任何使用相同
# `/v1/chat/completions` API 的端点:多 provider 前面的网关、代理,
# 或你控制的硬件上的运行的模型。API 服务器为内置
# agent 读取它,两个发布的 Bot 也读
# 它,所以一行就能移动整个部署,而不只是一个 Bot
#
# 模型名逐字传输,所以用端点发布的名称。对目录
# 命名空间化的端点,在 `BOT_MODEL` 和租户包的
# `default_model` 中都要名称的两半:
#
#   OPENAI_BASE_URL=https://gateway.internal/v1
#   OPENAI_API_KEY=...
#   BOT_MODEL=openai/gpt-5.5
#
# OPENAI_BASE_URL=

# 在非 OpenAI 或 Azure 的 OPENAI_BASE_URL 之下,内置 Bot 调用该端点的
# Chat Completions API(大多数兼容端点提供的就是它),除非则其
# 模型只通过 Responses API 使用工具(gpt-5.6 及之后、-pro 系列、
# gpt-5.3-codex、网关下的 `openai/` 名称亦然):它们调用
# `/responses`,由 OpenAI 前面的
# 瑽关或代理提供。提供 Responses API 的网关会为每个带
# `responses` 的模型保留 Responses-only
# 功能,如推理摘要。`chat` 对每个模型强制使用 Chat Completions;任何
# 其他值在内置 Bot 运行时都是错误
# COPILOTKIT_OPENAI_API=responses

# 决定首页未标记消息发给哪个 Bot 的模型。它在人
# 等待对话打开时运行,所以默认是轻量模型(Anthropic 上是
# claude-haiku-5-5,OpenAI 上是 gpt-6-luna),被拒绝时回退到
# Bot 的模型。在 OPENAI_BASE_URL / ANTHROPIC_BASE_URL
# 之后(背后)什么都不假设:除非设置了此项,否则使用 Bot 的模型
# ROUTER_MODEL=gpt-6-luna

# 可选的听写转录,独立于每个 agent/chat provider。一起设置
# provider、base URL 和模型。该端点必须在此
# base URL 下实现 POST /audio/transcriptions(需要时
# 包含 /v1)。不继承任何聊天端点或 API 密钥
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=gpt-transcribe
# TRANSCRIPTION_API_KEY=
# 对于显式配置的无认证本地服务,密钥可以省略

# 可选的实时语音通话。独立于听写转录和每个 agent 的聊天
# provider。
# 选择 openai-realtime(WebRTC)或 xai-realtime(Grok Voice over WebSocket)
# VOICE_PROVIDER=openai-realtime
# VOICE_MODEL=gpt-realtime
# VOICE_NAME=marin
# VOICE_API_KEY=$OPENAI_API_KEY
# Grok 替代方案:VOICE_PROVIDER=xai-realtime、VOICE_MODEL=grok-voice-latest、
# VOICE_NAME=ara、VOICE_API_KEY=$XAI_API_KEY(单独定义 XAI_API_KEY)。

# 可选。仅当容器需要通往同一兼容端点的不同路由时
# 才设置,例如本地托管的模型其 host URL 是 localhost 但
# Compose 网络 URL 是服务名。为空表示容器也使用 OPENAI_BASE_URL
# OPENAI_CONTAINER_BASE_URL=

# 另外两个 provider 同理,用 API 服务器已读取的名称。它们是
# 不同的 API,而非这一个的不同 URL,所以各有各的
# ANTHROPIC_BASE_URL=
# GOOGLE_GENERATIVE_AI_BASE_URL=

# 框架 Bot 的 provider:openai、anthropic 或 google。它读取该 provider
# 自己的密钥,没有则拒绝启动,所以 Anthropic 上的部署从不需要 OpenAI 密钥
# 框架架。概念验证 Bot 只能是 OpenAI,由构造决定:它直接使用该 API
# BOT_PROVIDER=openai
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# 用登录代替密钥:来自 `claude setup-token` 的 Anthropic 令牌,以及已登录
# ChatGPT 计划写入的文件。桌面应用在以那种方式连接 provider
# 时会同时设置两者;自己配置的盒子在这里设置它们。API 服务器为内置
# agent 读取它们,compose 将它们传给所选的 harness。见
# docs/configuration.md
# CLAUDE_CODE_OAUTH_TOKEN=
# CHATGPT_AUTH_FILE=

# 框架 Bot使用的模型。按 provider 各有默认:gpt-5.5、
# claude-sonnet-5-5、gemini-2.5-flash。5.6 层级在这里有效:设置
# 一个后 Responses API 会自动开启。它以前在这些模型上
# 完全不回答——RUN_STARTED、RUN_FINISHED、没有
# 文本——因为该 API 流式传输内容块而不是字符串,而运行读取的只是
# 字符串。默认保持 5.5,让两个发布的 Bot 开箱即用时保持一致
# BOT_MODEL=gpt-5.5

# 仅限 OpenAI,且很少需要:框架 Bot 会自行为
# 需要的模型开启 Responses API。当你使用的模型这个构建还
# 没听说过时才设置它
# BOT_RESPONSES_API=false

# 框架 Bot 思考的力度,用于支持推理的模型。是 OpenAI 的设置,
# 也是 Responses API 传输的,所以它需要在该 API 上运行的模型——5.6
# 层级会自动开启,其他模型都需要
# BOT_RESPONSES_API=true。未设置时,模型保持其 provider自己的默认值
#
# 取值之一:none、minimal、low、medium、high、xhigh、max。其他值都会让 Bot
# 拒绝启动并说明原因,而不是用一个悄悄走向无效的设置启动
# BOT_REASONING_EFFORT=

# Bot 的计算机。缺省意味着该功能关闭,其路由不会挂载
AGENT_COMPUTER_URL=http://localhost:4100
# 每个计算机要求其调用方出示的密钥。`agent-computer` 驱动持有真实
# 登录的浏览器,而策略、审计和登录都在 API 服务器中。没有此值
# 计算机拒绝启动,且拒绝每个未出示它的请求。用长的随机值;
# `scripts/start.sh` 会为你设置一个开发用的
COMPUTER_TOKEN=
# 仅限本地,注释掉是因为此文件会被复制。取消注释会让 Bot 浏览
# 这台机器自己的服务,这正是笔记本电脑想要的、部署绝对不能要的:
# 它在浏览和端点注册中解除了私网地址限制
# NODE_ENV=production 下设置它服务器拒绝启动
# AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
#
# agent 可注册的私网地址,一次一个,逗号分隔。这是
# 部署用来代替上面开关的做法:自带 agent,跑在
# 自己的网络,不解除浏览或任何其他方面的私网限制
#
# 主机,可带端口。`agents.internal` 覆盖该主机上的任何端口;
# `10.0.0.42:9000` 固定该主机。精确匹配——无通配符、无后缀——
# 启动时拒绝 URL 或 `*`,而不是悄悄永不匹配。永远不允许的
# 地址(包括云元数据)也不能反向注册。未设置意味着无,这是默认姿态
#
# AGENT_ENDPOINT_ALLOWED_HOSTS=agents.internal,10.0.0.42:9000
#
# Bot 在其计算机上可以做什么,一个 JSON 对象。缺省使用内置默认值,
# 它允许 acting 工具且不禁止任何东西,无论如何都会记录每个动作
#
# `deny` 先求值且优先于 `allow`。空 `allow` 什么都不允许,缺失的
# 策略什么都不允许,解析失败的规则会拒绝而不是放行。服务器
# 拒绝启动设置熔malformed 的此项,所以无效的限制永远不会回退
# 到放任行为
#
# 每个 Bot 的计算机和工作区/浏览器 profile 是独立容器、独立
# 卷,所以一个 Bot 读不了另一个的文件、用不了另一个的登录,
# 每个动作都记录是哪个 Bot 做的。规则仍可以用 `bot.id` 限制单个 Bot
#
# 属性:tool.name, intent, bot.id, actor.id, page.url, page.host,
#             element.ref/role/name/type, key, command, file.path, file.name, file.extension,
#             mcp.server, mcp.tool, mcp.effect, initiator.kind, initiator.id
#
# 对产生同一效果的多条路由命名。表单可以从其任一字段的按键提交,所以只
# 挡 Submit 按钮的规则挡不住来自其他字段的 Enter。下面的示例正是出于
# 这个原因,从两个能按键的工具上直接拒绝激活类按键:一个
# key 动作,一个携带 `submit` 的 type 动作。它问的是
# `intent == "activate"` 而不是 `key == "Enter"`,所以带修饰
# 键(Shift+Enter)的 Enter、`\n` 和 Space 也被拒绝
#
# 函数:contains(haystack, needle) 和 matches(value, pattern),都忽略大小写
#
# `enforce` 阻断;`dry-run` 决定并记录但放行一切,所以新规则可以先
# 在真实流量上试运行,再开始拒绝任何人的工作
#
# AGENT_COMPUTER_POLICY={"mode":"enforce","deny":["(intent == \"activate\" && contains(element.name, \"submit\")) || ((tool.name == \"computer_key\" || tool.name == \"computer_type\") && intent == \"activate\")"],"allow":["true"]}

# 一个动作等待其元素多久,毫秒。由 agent-computer 读取,不是服务器
# ACTION_TIMEOUT_MS=10000

# 计算机上的命令可以看到的额外环境变量,按名称,逗号分隔
# shell 已接收 PATH、locale、terminal 和 proxy 变量。Proxy
# userinfo 会被剥离,所以 HTTP_PROXY 中的密码不在 `env` 里。它不继承此进程的
# 其余部分,所以 KEY_ENCRYPTION_KEY 和其他部署密钥不在 `env` 里。在这里
# 命名密钥或凭证代理是运营者的决定
# COMPUTER_SHELL_ENV=JAVA_HOME,GOPATH

# 计算机监听的地址。未设置时托管的计算机监听所有网卡,容器
# 需要这样。直接跑在笔记本电脑上的计算机(`bun run dev` 在
# agent-computer 中)也会被局域网访问;它的 API 需要计算机令牌,但没有别的
# 需要访问,所以在那里设 127.0.0.1。驱动原生 Chrome 的计算机
# (OpenBot Desktop 的)总是监听回环地址,无论此项设什么
# COMPUTER_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# 计算机的 profile 及其流量出口
# ---------------------------------------------------------------------------

# agent-computer 内的 Chromium profile 目录,从 docker-compose.yml
# 的 `agent-profiles` 卷挂载。指向未挂载的位置会禁用
# 登录持久化
# PROFILES_DIR=/profiles

# Bot 计算机使用的浏览器进程。托管模式下总是用完整 Chromium。`headed`
# 是托管计算机运行的地方(Linux:容器、pod、桌面应用的引擎)的默认:在
# 计算机自己的虚拟显示器后面的完整 Chromium,与真实屏幕相同,bot 检查
# Cloudflare 的挑战在这种模式下远少于 headless。`headless` 仍可用、更小,且
# 是计算机直接跑在 macOS 或 Windows 上的默认,那种环境下 headed 会开窗口
# COMPUTER_BROWSER_BACKEND=managed
# COMPUTER_BROWSER_MODE=headed

# 当计算机关闭浏览器时,在内存限制的该比例及以上(按
# kubelet 的读法,即工作集,不含页缓存)时,除了上限
# (COMPUTER_MAX_BROWSERS)和空闲超时(COMPUTER_BROWSER_IDLE_MS),它会
# 关闭一分钟内没人用过的浏览器,最少最近使用的先关,直到
# 低于该值十分。内存在每次启动前读取,且每分钟读取一次,所以两次
# 检查之间增长的页面仍可能把它挤出内存。没有内存限制的容器
# 以机器内存衡量;容器外的计算机不为内存关闭任何东西。all-in-one
# 镜像中该比例有意把数据库和 API 服务器也算进去:内存耗尽时的
# 关闭逻辑同样计算它们。0 关闭该功能
# COMPUTER_MEMORY_HIGH_PERCENT=85
# Bot 的后台标签页闲置多久后会被关闭,毫秒:Bot 留下的
# 标签页,比如登录弹窗从中打开的那个页面。Bot 当前所在的页面、人
# 自己的浏览器、以及人握着方向盘的 Bot 的任何标签页都
# 永远不会被关闭。0 表示全部保留
# COMPUTER_TAB_IDLE_MS=600000

# Web Bot Auth:Bot 浏览器发出的每个请求都签名表明
# 来自本部署(Ed25519,HTTP Message Signatures),公钥发布在
# <OPENBOT_PUBLIC_URL>/.well-known/http-message-signatures-directory。默认
# 关闭,因为它向 Bot 访问的每个站点宣告本部署的 URL。`on` 需要
# OPENBOT_PUBLIC_URL(或 BETTER_AUTH_URL)是 https 且不是本机,否则被拒绝。它只有
# 在部署向 Cloudflare 注册后才真正有用,这是
# 一步手动操作:见 docs/configuration.md
# WEB_BOT_AUTH=on
# 签名密钥,JSON Web Key 格式的 Ed25519 私钥。未设置时从
# KEY_ENCRYPTION_KEY 派生,每台副本相同,所以启动不需要新东西。永不记录
# WEB_BOT_AUTH_KEY=

# 在与本地 API 部署同一台机器上启用已安装 Chrome:
# bun scripts/start-local-chrome-computer.ts
# 该助手需要 COMPUTER_TOKEN,绑定 127.0.0.1:4101,并保留每个 Bot 专属的
# profile。在 API 上设置 AGENT_COMPUTER_URL=http://127.0.0.1:4101,清除
# COMPUTER_SUPERVISOR_URL 和
# COMPUTER_SANDBOX_NAMESPACE,然后重启 API。完整设置见
# docs/configuration.md。本机模式需要 headed;不要在其环境中留下显式的
# headless 覆盖设置
# COMPUTER_BROWSER_BACKEND=local-chrome
# COMPUTER_BROWSER_MODE=headed
# 可选的应用所有的数据根目录的绝对路径;默认为平台的
# OpenBot 用户数据目录
# OPENBOT_LOCAL_COMPUTER_DIR=

# OpenBot 浏览器:每个人自己的浏览器,从 OpenBot 打开且已
# 内置 Recorder并连接。未设置时,下方的 supervisor 给它一台
# 自己的计算机(云端计算机上它访问开放网络、
# 这个 OpenBot 和 Intelligence 网关,部署内部一无所获);所有
# Bot 共享的那台计算机从不运行它。设置后,它跑在这台计算机上,
# 作为人自己桌面上的窗口,而 Bot 的计算机留在原地:
# OpenBot Desktop 将它指向宿主侧的本地 Chrome 计算机,用
# COMPUTER_TOKEN 调用。其中的 Recorder通过 OPENBOT_PUBLIC_URL
# (或 BETTER_AUTH_URL)访问 OpenBot,该地址必须是
# https,或 http 于 127.0.0.1 或 [::1] 带端口
# OPENBOT_BROWSER_URL=http://127.0.0.1:4101
# 这台计算机属于哪个 Bot,因此使用哪个 profile目录
# COMPUTER_BOT_ID=shared

# 每个 Bot 的出口身份。Bot 浏览器的所有流量都经过的代理,
# 远端因此看到一个可以加白名单或归因于该 Bot的
# 稳定地址。`EGRESS_PROXY_<BOT>` 指定一个 Bot,
# `EGRESS_PROXY_DEFAULT` 覆盖其余的,未设置意味着浏览器直接出去
#
# 凭据可以放在 URL 中,并在 Playwright 看到之前被拆分出来。只有 HOST
# 会出现在管理页面或 API 上,所以密码不会出现在屏幕上
#
# 这是归因(attribution),不是匿名(anonymity),它本身不是边界:它给安全团队
# 一个与 AGENT_COMPUTER_POLICY 并用的按 Bot 地址
#
# 这些放在本文件旁的 `egress.env` 中,不在这里。名称是按 Bot 的,所以
# Compose 无法像列出下面的每个变量那样列出它们,它只把被告知的
# 东西交给容器。在 `.env` 中它们到不了任何进程,且
# 浏览器直接出去,没有任何说明
#
#   EGRESS_PROXY_DEFAULT=http://user:password@proxy.internal:8080
#   EGRESS_PROXY_SALES_BOT=http://sales.proxy.internal:8080
#
# 住宅或 ISP 代理放在同一位置,是运营者知情
# 下的选择:Bot 的流量随后从消费者 ISP 拥有的地址离开,
# 所以网站看到的是像在家里的人而不是数据中心。默认关闭。出口过滤器
# 仍然先应用
#
#   EGRESS_PROXY_DEFAULT=http://customer-user:password@gateway.residential.example:8000


# 托管的 coworker AG-UI 端点。可选:使用 HTTP(S) URL,
# 并随其设置 MANAGED_AGENT_TOKEN。URL 无令牌则拒绝启动;无
# URL 的遗留令牌被忽略
#
# 单容器镜像中未设置,该镜像不带 Bot。`scripts/start.sh`
# 为笔记本电脑把它指向 4201 上的 agent-langgraph。4200 上的概念验证手写协议
# 并把循环留给任何监听者,所以它是参考,而不是要构建部署的
# 基础
# MANAGED_AGENT_AG_UI_URL=http://localhost:4201/ag-ui
# 服务器每次调用托管 Bot 时发送的共享密钥,作为
# `x-openbot-agent-token` 头。与上面的 URL 一起必需;服务器
# 没有两者也能启动
#
# `scripts/start.sh` 会生成一个并在首次运行时写回这里,
# 所以本地留空即可。自己部署时自己设置:openssl rand -base64 32
MANAGED_AGENT_TOKEN=

# 盒子里的第二个 Bot 跑在 http://localhost:4201/ag-ui 上,
# 用框架而非概念验证,到达方式相同:把 MANAGED_AGENT_AG_UI_URL 指向它,
# 或把它作为一个自己的 Bot 加到租户包或 /bots 中
# Bot 使用的模型。BOT_MODEL 是框架 Bot 的:默认 gpt-5.5,
# 且为需要它的模型自行切换到 Responses API——5.6 层级会,
# 因为 5.6 拒绝 /v1/chat/completions 上的函数工具
#
# 概念验证 Bot 有自己的 AGENT_BOT_MODEL,默认
# gpt-5.5,因为它手写该端点并拒绝在无法
# 使用其工具的模型上启动。一个变量同时用于两者,
# 意味着框架 Bot 的模型悄悄拿走了另一个的工具
# AGENT_BOT_MODEL=gpt-5.5
# BOT_RESPONSES_API=false

# 每人一台计算机。未设置时,每个 Bot 共享 AGENT_COMPUTER_URL
# 上的计算机,适合笔记本且明确是共享机器。设置后,
# supervisor 给每个人一台自己的容器,其中他们的每个
# Bot 有自己的文件夹和浏览器 profile,并给标记为
# Isolated 的 Bot 自己的容器。人自己的 OpenBot 浏览器
# 只跑在自己的计算机上,所以它需要这个(或上面的 OPENBOT_BROWSER_URL):在
# 共享计算机上,Bot 的 shell 能从磁盘读取
# 人的登录信息
COMPUTER_SUPERVISOR_URL=
# 与 supervisor 共享。不是安全边界(那是它的四个动词),但它
# 把其他任何能到达该端口的东西挡在外面,不让它们
# 轮换 Bot 的计算机
SUPERVISOR_TOKEN=
# 设置后每个计算机都跑在 gVisor 下,前提是主机安装了
# 它。未设置时,计算机是普通容器,共享主机内核,
# Bot 不是自己的时值得知道
COMPUTER_RUNTIME=

# 框架 Bot 通过此服务器回调工具时出示的密钥。Bot 运行自己的
# 循环、自己的进程,但仍不能直接触达 vendor:它调用
# 授予工具的部署,授权、策略和审计行都在那里。缺省时没有
# Bot 可以回调工具,且会被如此告知,而不是被悄悄放行
AGENT_TOOL_TOKEN=

# 例行 worker 把运行交回此服务器时出示的密钥。它只认证
# 一个例行运行 id 的移交,别无其他:服务器会重新从数据库
# 读取例行程序、Bot 和它需要的其他一切,所以 worker 不能用它注入指令
#
# 独留空时,内部端点拒绝每个调用,没有任何例行程序
# 会触发——尚未搭建 worker 的部署的正确状态。已搭建的部署设置
# 它:openssl rand -base64 32。本地 `scripts/start.sh` 回退到
# 固定的开发值。生产环境不接受默认值
WORKER_SHARED_SECRET=

# Composio,为几百个应用托管人们账户的 broker,让 bot
# 无需本部署向每个应用注册 OAuth 客户端就能
# 在 gmail、Slack 或 Notion 中操作
#
# `bash scripts/start.sh` 自动使用与 Intelligence 相同的
# CopilotKit CLI 登录来开通一个隔离的 Composio 项目。单独
# 准备时运行 `bun run setup:composio`;它不需要
# Learning 容器。兼容的已发布 CLI 必须支持
# `integrations composio provision`,且其托管开通服务必须已启用。提供的密钥
# 从不会被替换。Arcade 选择和 Arcade 专用密钥跳过此步骤。
# 助手先把 OPENBOT_INSTALLATION_ID 存入私有的
# `.env.openbot-installation-id`,然后 CLI 把项目密钥写到这里。为重试和
# 重启保留那个被忽略的身份文件;不要把它复制到新的安装中。
# DEPLOYMENT_ID 从不用作此身份。可以在首次设置前通过
# OPENBOT_INSTALLATION_ID 提供一个稳定的 UUID。之后的值必须与
# 已保存的一致。绝不把父级 Composio 组织凭据放进 OpenBot
#
# 这个变量是整个设置。产品中没有任何页面会设置
# 它:它在启动时从此环境读取,拥有所有权限的
# 管理员也无法从页面开启 Composio
#
# 整个部署一把密钥,而非每人一把。Composio 用随每次调用发送的
# user id 区分人,所以一个账户的连接永远不会被另一个触达
COMPOSIO_API_KEY=

# 可选,按应用。以服务器到服务器授权(S2S_OAUTH2)连接的
# Composio 应用需要运行此部署的人注册的 OAuth 客户端;Shopify
# 就是一个。为该应用的 slug 设置两半部分,大写,用连字符
# 代替下划线。只有一半不算客户端,该应用不会出现在
# 选择器中
# COMPOSIO_SHOPIFY_CLIENT_ID=
# COMPOSIO_SHOPIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 关联人们的 GitHub 账户
# ---------------------------------------------------------------------------

# GitHub App 让人们在 Settings -> Connected accounts -> Linked
# accounts 下关联自己的 GitHub 账户。把 App 的
# 回调 URL 注册为 <公共 URL>/api/identity/github/callback,并保持开启
# "Expire user authorization tokens"。关联不需要 webhook。同时设置
# client id 和 client secret,否则都不设:只设其一会让服务器启动时停止;
# 设置它们而没有公共 URL(OPENBOT_PUBLIC_URL 或 BETTER_AUTH_URL)也
# 一样。人们必须在同一浏览器中登录 OpenBot 才能连接。之后浏览器返回
# OPENBOT_APP_URL,应用和服务器在不同 origin 时
# 需要它
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 触达应用之外的人:Slack、Teams、短信、推送
# ---------------------------------------------------------------------------

# Slack 和 Microsoft Teams 通过 OpenTag 部署接入,它作为 AG-UI
# agent 在 <公共 URL>/api/delivery/webhooks/opentag/agent 调用本
# 服务器。密钥至少 32 个字符,且与 OpenTag 的 AGENT_AUTH_HEADER
# bearer token 相同。OPENTAG_URL 是没有开启的 Slack 或 Teams
# 对话时消息的去向(批准后的回复、提问、进展);没有它
# 这些发送会显式失败。设置 OPENTAG_URL 或图标而没有
# 密钥会让服务器在启动时停止。旧的 SLACK_* 设置会在启动时
# 被拒绝
# OPENTAG_SHARED_SECRET=
# OPENTAG_URL=https://opentag.example.com
# OPENTAG_BOT_ICON_URL_TEMPLATE=https://avatars.example.com/{seed}.png

# origin provider 回调的公共地址,当它不是 OPENBOT_PUBLIC_URL 或
# BETTER_AUTH_URL 时(比如隧道)。Twilio 会对给它的
# URL 签名,所以必须与 Twilio 号码的设置一致
# DELIVERY_PUBLIC_URL=https://hooks.example.com

# 短信。四项全设或全不设:只设部分会让服务器启动时停止。把
# 号码的入站 webhook 指向
# <DELIVERY_PUBLIC_URL>/api/delivery/webhooks/sms
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# 推送到 mobile/ 中的原生应用。EXPO_PROJECT_ID 是应用的 EAS 项目
# UUID,同时开启推送和原生应用登录;设备只有在应用
# 报告相同 id 时才注册。访问令牌可选,作为 bearer token 发送给
# Expo 的推送服务
# EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
# EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# 入站邮件触发器
# ---------------------------------------------------------------------------

# 本域的 Amazon SES 收信发布到订阅了
# <公共 URL>/api/events/email/sns 的 SNS 主题。每个邮件
# 触发器的地址是 trigger-<id>@<域名>。两者都
# 需要;缺了它们邮件触发器就没有地址。来自其他主题的消息会被拒绝
# OPENBOT_INBOUND_EMAIL_DOMAIN=in.example.com
# OPENBOT_INBOUND_EMAIL_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:openbot-inbound

# ---------------------------------------------------------------------------
# 目录开通与审计导出
# ---------------------------------------------------------------------------

# <BETTER_AUTH_URL>/api/auth/scim/v2 处的 SCIM 2.0,
# 仅在设置了令牌时开启。目录迁移到新令牌时,
# _NEXT 令牌会随之一并被接受
#   openssl rand -base64 32
# SCIM_BEARER_TOKEN=
# SCIM_BEARER_TOKEN_NEXT=
# SCIM_CONNECTION_ID=directory

# 每条审计记录都作为 OTLP 日志记录通过 HTTP 传送,供 SIEM 或
# OpenTelemetry Collector 使用。任一端点都开启它:logs
# 端点按原样使用,通用端点走 /v1/logs。头是逗号分隔的
# key=value 对。OPENBOT_OTEL_EXPORT=off 在端点仍设置时也会关闭它
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=change-me
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_SERVICE_NAME=openbot
# OPENBOT_OTEL_EXPORT=off

# 通过现有的 CopilotKit sink获取丰富的 OpenBot 用量/运行/能力/
# 消耗遥测。自托管/本地评估需显式开启;桌面版在
# 其设置披露下默认开启。设 0 禁用;DO_NOT_TRACK=1 或
# COPILOTKIT_TELEMETRY_DISABLED=1 始终优先。不导出任何提示、回答、审计
# 载荷、URL、姓名或凭据。身份、覆盖范围和目标投递限制见
# docs/TELEMETRY.md
# OPENBOT_PRODUCT_TELEMETRY=1

# ---------------------------------------------------------------------------
# 自托管 OpenObserve(服务器运行时日志 + 审计副本)
# ---------------------------------------------------------------------------

# 应用 docker/observability/openbot-logging.compose.yml 作为可选叠加层
# 它转发选定的容器日志并把服务器的审计 OTLP 路由到收集器
# 在 docker/observability/env.openobserve 中配置运营者和摄入凭据
# 见 docs/observability-openobserve.md

# ─── 支付宝渠道(#70,server/src/payments/alipay/config.ts)──────────────────
# 所有变量一起出现才生效;缺任何一个都会拒绝启动,而不是带着半套
# 渠道配置上线。全部未设置 = 未部署该渠道,不挂 /payment-callbacks/alipay。
# 密钥是 PEM(PKCS8 私钥 / 平台公钥),换行写成 \n。
# ALIPAY_APP_ID=2021000123456789
# ALIPAY_SELLER_ID=2088000000000000
# ALIPAY_MERCHANT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# ALIPAY_NOTIFY_URL=https://your-domain.example/payment-callbacks/alipay
# ALIPAY_RETURN_URL_WHITELIST=https://app.example.invalid
# ALIPAY_REQUEST_TIMEOUT_MS=10000
