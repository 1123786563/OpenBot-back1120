# Copy values ONLY into deploy/t01/.env.t01, not app/VITE_* variables.
# bun deploy/t01/setup.ts creates random local secrets and does not overwrite an existing file.
# Provide a dedicated TEST Intelligence project; do not copy production/developer keys by default.
OPENBOT_SINGLE_USER=false
OPENBOT_EDITION=team
DEPLOYMENT_ID=openbot-t01
PORT=13001
SERVER_PORT=13001
BETTER_AUTH_URL=http://localhost:13001
OPENBOT_APP_URL=http://localhost:13001
TRUSTED_ORIGINS=http://localhost:13001
OKTA_OAUTH_ISSUER=http://localhost:18000
INITIAL_ADMIN_EMAILS=a@t01.test
SIGNIN_ALLOWED_EMAIL_DOMAINS=t01.test
OKTA_OAUTH_CLIENT_ID=
OKTA_OAUTH_CLIENT_SECRET=
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
BOT_MODEL=
# CopilotKit's own protocol switch for the model above (responses or chat); not a secret.
COPILOTKIT_OPENAI_API=
OPENBOT_PRODUCT_TELEMETRY=0
OPENBOT_LEARNING_AUTO_ASSIGN=false
OPENBOT_MEMORY_SOURCE_DEFAULTS=false
COMPUTER_SUPERVISOR_URL=http://127.0.0.1:45430
AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
TENANT_PACKAGE_DIR=../examples/fintech
APP_DIST_DIR=../app/dist
# Generated by setup.ts (empty here deliberately)
DATABASE_URL=
TEST_DATABASE_URL=
T01_DB_PASSWORD=
T01_CASDOOR_DB_PASSWORD=
BETTER_AUTH_SECRET=
KEY_ENCRYPTION_KEY=
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
WORKER_SHARED_SECRET=
AGENT_TOOL_TOKEN=
