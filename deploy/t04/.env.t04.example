# Copy values ONLY into deploy/t04/.env.t04, not app/VITE_* variables.
# bun deploy/t04/setup.ts creates random local secrets and does not overwrite an existing file.
# Provide a dedicated TEST Intelligence project; do not copy production/developer keys by default.
AUTH_MODE=casdoor
OPENBOT_SINGLE_USER=false
OPENBOT_EDITION=team
DEPLOYMENT_ID=openbot-t04
PORT=14003
OPENBOT_LISTEN_HOSTNAME=127.0.0.1
SERVER_PORT=14003
BETTER_AUTH_URL=http://localhost:14003
OPENBOT_APP_URL=http://localhost:14003
TRUSTED_ORIGINS=http://localhost:14003
CASDOOR_OAUTH_ISSUER=http://localhost:19002
INITIAL_ADMIN_EMAILS=
SIGNIN_ALLOWED_EMAIL_DOMAINS=
CASDOOR_OAUTH_CLIENT_ID=
CASDOOR_OAUTH_CLIENT_SECRET=
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
CPK_INTELLIGENCE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
BOT_MODEL=
# CopilotKit's own protocol switch for the model above (responses or chat); not a secret.
COPILOTKIT_OPENAI_API=
OPENBOT_PRODUCT_TELEMETRY=0
OPENBOT_LEARNING_AUTO_ASSIGN=false
OPENBOT_MEMORY_SOURCE_DEFAULTS=false
APP_DIST_DIR=../app/dist
TENANT_PACKAGE_DIR=../examples/fintech
# T04 test-only fault control. The launcher adds OPENBOT_TEST_FAULT_FILE separately; this file
# never names it, so a deployment started without the launcher has no fault control at all.
# Generated by setup.ts (empty here deliberately)
DATABASE_URL=
TEST_DATABASE_URL=
T04_DB_PASSWORD=
T04_CASDOOR_DB_PASSWORD=
BETTER_AUTH_SECRET=
KEY_ENCRYPTION_KEY=
WORKER_SHARED_SECRET=
AGENT_TOOL_TOKEN=
